# HTTP service
HOST=127.0.0.1
PORT=3010
MEMORY_DB_PATH=./data/memory.sqlite

# Set a long random value before binding HOST to a non-loopback interface.
# MEMORY_API_KEY=replace-with-a-secret-from-your-secret-store

# Used by CLI and MCP adapter.
MEMORY_API_URL=http://127.0.0.1:3010

# Optional semantic recall. Leave disabled for a fully local installation.
MEMORY_EMBEDDING_PROVIDER=disabled
# OPENAI_API_KEY=replace-with-a-secret-from-your-secret-store
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_EMBEDDING_TIMEOUT_MS=15000
# MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
